# Copy this file to .env.local (local) or add the same names in Vercel > Settings > Environment Variables.
# This template contains NO secrets and is safe to be public. Never put a real key in this file.

# ---- AI: one key powers every AI task (questions, evaluation, resume, reports, plans) ----
# Leave AI_API_KEY empty to stay in Demo Mode (free, no key).
#
# FREE options (no credit card):
#   AI_PROVIDER=gemini   key: aistudio.google.com/apikey         (model defaults to gemini-flash-latest)
#   AI_PROVIDER=groq     key: console.groq.com/keys              (set AI_MODEL; run `npm run check:ai` to list models)
# Paid options: anthropic (default model claude-sonnet-5-5), openai (set AI_MODEL), openrouter (set AI_MODEL)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
# Only for a custom OpenAI-compatible host. Leave empty otherwise.
AI_BASE_URL=

# ---- Shared rate limiting (recommended in production, optional locally; free at upstash.com) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Coming with login + database (not used yet; free Postgres at neon.com) ----
DATABASE_URL=
AUTH_SECRET=
STORAGE_URL=
