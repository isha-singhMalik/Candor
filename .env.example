# ---- AI (optional) -------------------------------------------------
# Leave AI_API_KEY empty to run Candor in Demo Mode (no paid API needed).
# Keys are only ever read on the server. Never prefix them with NEXT_PUBLIC_.
AI_PROVIDER=anthropic          # anthropic | openai
AI_API_KEY=
AI_MODEL=                      # e.g. your preferred model id for the chosen provider

# ---- Database (Phase 4: Prisma + PostgreSQL, not required for the MVP) ----
DATABASE_URL=

# ---- Auth (Phase 4: Auth.js, not required for the MVP) -----------------
AUTH_SECRET=                   # generate with: npx auth secret   (or: openssl rand -base64 32)

# ---- Storage (Phase 4: resume file storage, MVP discards files after parsing) ----
STORAGE_URL=
